{
  "servers": {
    "kotlin-lsp": {
      "command": "cmd",
      "args": ["/c", "kotlin-lsp.cmd", "--stdio"],
      "fileTypes": [".kt", ".kts"],
      "languageId": "kotlin",
      "rootMarkers": ["settings.gradle.kts", "build.gradle.kts", "build.gradle", ".git"],
      "warmupTimeoutMs": 600000
    }
  }
}